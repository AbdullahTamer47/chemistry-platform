# ========================================================
# منصة كيمياوي - د. زياد رمزي عياد للكيمياء
# Environment Configuration Template (.env)
# ========================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Security & Authentication
# Strong random secret key for signing JWT tokens (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOM_BYTES_48_HEX

# Allowed CORS Origins (comma-separated, or * for all)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Electronic Payment Receiving Accounts (Vodafone Cash / InstaPay / Fawry / WhatsApp)
# Note: These can also be configured and changed directly from the Teacher Admin Dashboard!
PAY_VODAFONE_NUMBER=01012345678
PAY_INSTAPAY_HANDLE=ziad.ramzy@instapay
PAY_FAWRY_MERCHANT=788
SUPPORT_WHATSAPP=201012345678
